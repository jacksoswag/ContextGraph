SERPER_API_KEY=paste_your_serper_api_key_here
SCRAPE_DEFAULT_LIMIT=24
RESEARCH_GOOGLE_SEARCH_LIMIT=16
RESEARCH_GOOGLE_SCHOLAR_LIMIT=8
RESEARCH_BLOCKS_PER_SOURCE=24
RESEARCH_ACCEPTED_LIMIT=12
RESEARCH_SETTLE_BLOCK_LIMIT=192
RESEARCH_SETTLE_VALUES_PER_BLOCK=8
RESEARCH_SETTLE_VALUE_LIMIT=1024
RESEARCH_CACHE_TTL_SECONDS=604800
COREF_ENABLED=1
RESEARCH_CACHE_PATH=.di-ui/research_cache.sqlite

# ── LLM tier tags (Ollama). Swap to a non-reasoning 7B (e.g.
#    qwen2.5:7b-instruct) when the <think> latency tax outweighs reasoning gains.
DI_MODEL_1B=llama3.2:1b
DI_MODEL_3B=llama3.2:3b
DI_MODEL_7B=deepseek-r1:7b

# ── LLM tuning. KEEP_ALIVE holds the resident model warm across pipeline
#    stages of a single turn. METRICS_PATH gets one JSONL line per LLM call.
DI_LLM_KEEP_ALIVE=10m
DI_LLM_METRICS_PATH=.di-ui/perf.jsonl

# ── Live semantic merge: collapse near-duplicate nodes at ingest time.
#    Uses the same FTS+cosine+density+threshold logic as the sleep pass but
#    runs per-node on the synchronous embed path. Disabled by default; enable
#    for sessions where drift accumulation matters more than ingest latency.
#    Has no effect in deferred (batch) mode — use scripts/sleep.py for that.
DI_LIVE_MERGE=0

# ── Deep web digest: cross-paragraph stitching over spaCy-extracted clauses.
#    Disabled by default. Runs on the 3B tier (override DI_DEEP_DIGEST_MODEL).
#    Each digest is cached by article hash so re-retrieval never re-pays cost.
DI_DEEP_WEB_DIGEST=0
DI_DEEP_DIGEST_MODEL=3B
DI_DEEP_DIGEST_MAX_ARTICLES=10
DI_DEEP_DIGEST_MAX_TRIPLES=120
